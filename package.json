{
	"name": "wip-obsidian-theme",
	"version": "1.0.1",
	"private": true,
	"scripts": {
		"build": "postcss src/index.css --output theme.css",
		"dev": "postcss src/index.css --output theme.css --watch",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "stylelint \"src/**/*.css\"",
		"lint:dist": "stylelint theme.css",
		"check": "npm run lint && npm run build && npm run lint:dist"
	},
	"devDependencies": {
		"postcss": "^8.5.6",
		"postcss-cli": "^12.0.0",
		"postcss-import": "^16.1.1",
		"stylelint": "^17.0.0",
		"stylelint-config-obsidianmd": "^0.1.0"
	}
}
